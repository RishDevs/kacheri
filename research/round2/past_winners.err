import subprocess,concurrent.futures
from bs4 import BeautifulSoup
def get(u):return BeautifulSoup(subprocess.check_output(['curl','-Ls',u]),'html.parser')
urls=[]
for h in ['nvidia-aws','hackaichallenge','hpaistudio','nemoclaw']:
 s=get(f'https://{h}.devpost.com/project-gallery')
 urls += [(h,a['href']) for a in s.select('a[href*=\"devpost.com/software/\"]') if 'Winner' in a.get_text()]
def f(pair):
 h,u=pair;s=get(u)
 for a in s(['script','style','nav','footer']):a.decompose()
 t=s.get_text(' ',strip=True)
 # relevant sections
 out=[h+' '+u]
 for term in ['Winner','Built With','How we built','Accomplishments']:
  start=0
  for i in range(4):
   p=t.lower().find(term.lower(),start)
   if p<0:break
   out.append(t[max(0,p-80):p+1700 if term=='How we built' else p+650]);start=p+len(term)
 return '\\n'.join(out)
with concurrent.futures.ThreadPoolExecutor(max_workers=12) as e:
 for r in e.map(f,urls):print(r+'\\n')
